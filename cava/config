[general]
bars=auto
bar_width=2
bar_spacing=1
sleep_timer=1
framerate=60
autosens=1
sensitivity=120
lower_cutoff_freq=50
higher_cutoff_freq=10000

[input]
method=pipewire
source=auto

[output]
method=ncurses
channels=stereo
mono_option=average
reverse=false

[smoothing]
integral=77
gravity=100
ignore=0

[eq]
1=1
2=1
3=1
4=1
5=1
6=1
7=1
8=1

[color]
background = 'default'

# Activar degradado
gradient = 1
gradient_count = 8

# Degradado monocromático en tonos rosa/fucsia (#ff2a85)
# De base magenta/rosa oscuro a fucsia encendido en las puntas:
gradient_color_1 = '#3a001a'
gradient_color_2 = '#5e002b'
gradient_color_3 = '#880040'
gradient_color_4 = '#b30d58'
gradient_color_5 = '#d9186c'
gradient_color_6 = '#f52280'
gradient_color_7 = '#ff2a85'
gradient_color_8 = '#ff66ad'

[fft]
bins=24
noise_reduction=0.65

[visual]
ascii_max_range=8
